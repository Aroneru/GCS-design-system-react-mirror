# Nilai bawaan untuk semua orang, termasuk workflow deploy. Berkas ini IKUT
# di-commit — isinya bukan rahasia, melainkan setelan default proyek.
#
# Vite hanya membuka variabel berawalan VITE_ ke kode klien, dan apa pun yang
# ada di sini ikut tertanam di bundle yang terbit. Jangan taruh rahasia.

# Easter egg di jendela kode beranda (foto latar berkedip + tombol suara).
# Mati di mana pun kecuali dinyalakan sendiri lewat .env.local.
# VITE_EASTER_EGG=false
